# ---------------------------------------------
# ENTORNO Y SERVIDOR
# ---------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ---------------------------------------------
DATABASE_URL="postgresql://minipay:adminminipay123@localhost:5433/minipay?schema=public"

# ---------------------------------------------
# SEGURIDAD Y HASHING (BCRYPT)
# ---------------------------------------------
# 10 a 12 salt rounds es el estándar ideal (seguro y rápido para el CPU)
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------
# AUTENTICACIÓN JWT
# ---------------------------------------------
# Usa claves seguras y de alta entropía (mínimo 32 caracteres aleatorios)
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------
# CORS (Orígenes permitidos)
# ---------------------------------------------
# Nunca usar '*' en producción; especificar la URL del frontend
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------
# RATE LIMITING (Throttler)
# ---------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=20
